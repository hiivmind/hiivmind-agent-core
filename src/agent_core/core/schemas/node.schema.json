{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "exits": {"type": "array", "items": {"type": "string"}},
    "allowed-tools": {"type": "array", "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "object"}},
    "improvisation": {"enum": ["on", "off", true, false]},
    "context": {"enum": ["none", "summary", "all"]}
  }
}
