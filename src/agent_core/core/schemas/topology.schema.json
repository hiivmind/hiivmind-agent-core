{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["nodes", "exits"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}}
      }
    },
    "exits": {"type": "object"},
    "improvisation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"setting": {"enum": ["on", "off", true, false]}, "node": {"type": "string"}}
    },
    "menu": {"type": "array", "items": {"type": "object"}},
    "greeting": {"type": "string"}
  }
}
