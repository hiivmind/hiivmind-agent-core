{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "nodes",
    "exits"
  ],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exits": {
      "type": "object"
    },
    "improvisation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setting": {
          "enum": [
            "on",
            "off",
            true,
            false
          ]
        },
        "node": {
          "type": "string"
        }
      }
    },
    "menu": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "greeting": {
      "type": "string"
    },
    "sequences": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sequence"
      }
    },
    "fragments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fragment"
      }
    }
  },
  "$defs": {
    "sequence": {
      "type": "object",
      "required": [
        "description",
        "start",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "$ref": "#/$defs/fan_out"
            }
          ]
        },
        "inputs": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/target"
            }
          }
        }
      }
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "end"
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/mapped"
        },
        {
          "$ref": "#/$defs/link"
        },
        {
          "$ref": "#/$defs/fan_out"
        }
      ]
    },
    "mapped": {
      "type": "object",
      "required": [
        "node",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "$ref": "#/$defs/node"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "link"
      ],
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fan_out": {
      "type": "object",
      "required": [
        "fan_out",
        "over",
        "as",
        "into"
      ],
      "additionalProperties": false,
      "properties": {
        "fan_out": {
          "$ref": "#/$defs/node"
        },
        "over": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "required": [
                "tool"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "object"
                }
              }
            }
          ]
        },
        "as": {
          "type": "string",
          "minLength": 1
        },
        "into": {
          "type": "string",
          "minLength": 1
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "tool",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fragment": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "exits",
        "start",
        "transitions"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "$ref": "#/$defs/fan_out"
            }
          ]
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fragment_target"
            }
          }
        }
      }
    },
    "fragment_target": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/mapped"
        },
        {
          "$ref": "#/$defs/fan_out"
        }
      ]
    }
  }
}
