[
  {
    "name": "exit",
    "description": "End the node that is running with one of its outcomes and the outputs it declares.",
    "schema": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "outputs": {
          "type": "object"
        }
      },
      "required": [
        "outcome"
      ]
    }
  },
  {
    "name": "ask",
    "description": "Ask the person a question and wait for the answer.",
    "schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        }
      },
      "required": [
        "question"
      ]
    }
  },
  {
    "name": "state_set",
    "description": "Record a value under a name. Whatever is recorded stays for the rest of the node run.",
    "schema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "key",
        "value"
      ]
    }
  },
  {
    "name": "state_get",
    "description": "Read a recorded value by name.",
    "schema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ]
    }
  },
  {
    "name": "load",
    "description": "Read a file of the instance and return its text.",
    "schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ]
    }
  }
]